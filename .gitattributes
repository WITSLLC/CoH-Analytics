# Normalize text files; keep binaries untouched.
* text=auto

# Source and project text — CRLF for Windows/.NET contributors
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf
*.runsettings text eol=crlf
*.ps1 text eol=crlf

# Docs and data interchange — LF
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
*.db binary
*.cohicons binary
*.bin binary
*.mdb binary
*.zip binary
*.nupkg binary
