<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- MSI ProductVersion is numeric major.minor.patch only; Beta is not embedded here. -->
    <InstallerVersion>0.1.3</InstallerVersion>
    <!-- Package identity for artifact folders and filenames (includes -beta suffix). -->
    <PackageVersion>0.1.3-beta</PackageVersion>
    <!-- Human-facing status string for ARP/shortcut text. -->
    <UserFacingVersion>0.1.3 Beta</UserFacingVersion>
    <PayloadDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\artifacts\release\$(PackageVersion)\installer-payload'))</PayloadDir>
    <OutputName>CoH-Analytics-$(PackageVersion)-win-x64</OutputName>
    <DefineConstants>PayloadDir=$(PayloadDir);UserFacingVersion=$(UserFacingVersion);InstallerVersion=$(InstallerVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="ValidatePayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(PayloadDir)\CoHAnalytics.exe')"
           Text="Windows Installer publish payload not found at '$(PayloadDir)'. Run eng/BuildWindowsInstaller.ps1 without -SkipPublish first." />
  </Target>

</Project>
