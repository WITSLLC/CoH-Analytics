<Window x:Class="CoHAnalytics.Shell.CharacterIconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CoHAnalytics.Converters"
        xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Select Character Icon"
        Icon="{StaticResource Image.ApplicationIcon}"
        Width="980"
        SizeToContent="Height"
        MaxHeight="780"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <windowShell:WindowChrome CaptionHeight="31"
                                  ResizeBorderThickness="0"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="CharacterIconPickerItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#0D2240" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#12305A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Brush.Warning}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource Brush.ChipActiveBackground}" />
                                <Setter Property="Effect"
                                        Value="{StaticResource Effect.PanelGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource Brush.ApplicationChrome}">
            <DockPanel Margin="8,0,46,0" LastChildFill="True">
                <Image Width="20"
                       Height="20"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Source="{StaticResource Image.ApplicationIcon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.ApplicationChromeText}"
                           Text="Select Character Icon" />
            </DockPanel>

            <Button Width="46"
                    Height="31"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Arrow"
                    Focusable="False"
                    ToolTip="Close"
                    windowShell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CancelButton_OnClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseButtonBackground"
                                            Background="{TemplateBinding Background}">
                                        <Path Width="9"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{StaticResource Brush.ApplicationChromeText}"
                                              StrokeThickness="1" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseButtonBackground"
                                                    Property="Background"
                                                    Value="#C42B1C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="22,16,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Select Character Icon"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Choose a built-in icon or import a custom image."
                           Style="{StaticResource Text.Muted}" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     Margin="0,12,0,10"
                     Padding="0"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding BuiltInIcons}"
                     SelectedItem="{Binding SelectedBuiltInIcon, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource CharacterIconPickerItem}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Image Width="96"
                               Height="96"
                               AutomationProperties.Name="{Binding AccessibleName}"
                               Source="{Binding ImageSource}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2"
                        Margin="0,4,0,10">
                <StackPanel Visibility="{Binding HasCustomIcons, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Margin="5,0,0,5"
                               Style="{StaticResource Text.MetricCaption}"
                               Text="CUSTOM ICONS" />
                    <ListBox MaxHeight="126"
                             Padding="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemsSource="{Binding CustomIcons}"
                             SelectedItem="{Binding SelectedCustomIcon, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CharacterIconPickerItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Image Width="96" Height="96"
                                       AutomationProperties.Name="{Binding AccessibleName}"
                                       Source="{Binding ImageSource}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Margin="5,4,0,0"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">
                    <Button MinWidth="150"
                            Content="Upload Custom Icon"
                            Style="{StaticResource Button.Ghost}"
                            Click="UploadCustomIconButton_OnClick" />
                    <Button MinWidth="190"
                            Margin="8,0,0,0"
                            Content="Delete Selected Custom Icon"
                            IsEnabled="{Binding CanDeleteSelectedCustomIcon}"
                            Style="{StaticResource Button.Ghost}"
                            Click="DeleteCustomIconButton_OnClick" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="88"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Cancel"
                        Style="{StaticResource Button.Ghost}"
                        Click="CancelButton_OnClick" />
                <Button MinWidth="88"
                        IsDefault="True"
                        IsEnabled="{Binding CanApply}"
                        Content="Apply"
                        Style="{StaticResource Button.Ghost}"
                        Click="ApplyButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
