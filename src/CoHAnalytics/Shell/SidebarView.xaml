<UserControl x:Class="CoHAnalytics.Shell.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CoHAnalytics.Converters"
             xmlns:nav="clr-namespace:CoHAnalytics.Navigation">
    <UserControl.Resources>
        <conv:ResourcePathToUriConverter x:Key="ResourcePathToUriConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <conv:WorkspaceEqualityConverter x:Key="WorkspaceEqualityConverter" />

        <Style x:Key="Button.SidebarNav" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,7,4,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.SidebarBackground}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding NavigationItems}"
                          HorizontalContentAlignment="Stretch"
                          Margin="0,14,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type nav:NavigationItem}">
                        <Grid Margin="0,2,0,2"
                              HorizontalAlignment="Stretch">
                            <Separator x:Name="Divider"
                                       Margin="8,8,8,8"
                                       Background="{StaticResource Brush.Border}">
                                <Separator.Visibility>
                                    <Binding Path="IsDivider">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </Separator.Visibility>
                            </Separator>

                            <Grid x:Name="NavItem"
                                  HorizontalAlignment="Stretch"
                                  Visibility="{Binding IsDivider, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Border x:Name="SelectionBackground"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent"
                                        CornerRadius="4,0,0,4" />
                                <Polygon x:Name="SelectionTab"
                                         Visibility="Collapsed"
                                         Fill="{StaticResource Brush.NavSelected}"
                                         Points="0,14 10,18 0,22"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,0,-1,0" />
                                <Button Style="{StaticResource Button.SidebarNav}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding WorkspaceId}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource Icon.Layout.NavigationColumn}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Style="{StaticResource Icon.Navigation}"
                                               Source="{Binding IconPath, Converter={StaticResource ResourcePathToUriConverter}}" />
                                        <TextBlock x:Name="LabelText"
                                                   Grid.Column="1"
                                                   Margin="{StaticResource Icon.Layout.NavigationLabelMargin}"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource WorkspaceEqualityConverter}">
                                        <Binding Path="DataContext.SelectedWorkspaceId" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        <Binding Path="WorkspaceId" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="SelectionBackground" Property="Background" Value="{StaticResource Brush.NavSelected}" />
                                <Setter TargetName="SelectionTab" Property="Visibility" Value="Visible" />
                                <Setter TargetName="LabelText" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
