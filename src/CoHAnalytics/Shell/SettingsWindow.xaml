<Window x:Class="CoHAnalytics.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CoHAnalytics.Converters"
        xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Icon="{StaticResource Image.ApplicationIcon}"
        Width="760"
        Height="500"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <windowShell:WindowChrome CaptionHeight="31"
                                  ResizeBorderThickness="0"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource Brush.ApplicationChrome}">
            <DockPanel Margin="8,0,46,0"
                       LastChildFill="True">
                <Image Width="20"
                       Height="20"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Source="{StaticResource Image.ApplicationIcon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.ApplicationChromeText}"
                           Text="Settings" />
            </DockPanel>

            <Button Width="46"
                    Height="31"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Arrow"
                    Focusable="False"
                    ToolTip="Close"
                    windowShell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_OnClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseButtonBackground"
                                            Background="{TemplateBinding Background}">
                                        <Path Width="9"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{StaticResource Brush.ApplicationChromeText}"
                                              StrokeThickness="1" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseButtonBackground"
                                                    Property="Background"
                                                    Value="#C42B1C" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CloseButtonBackground"
                                                    Property="Background"
                                                    Value="#A62317" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,18,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontFamily="{StaticResource Font.Primary}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           Text="Settings" />
                <TextBlock Margin="0,8,0,12"
                           Style="{StaticResource Text.SectionTitle}"
                           Text="FILE LOCATIONS" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Border Margin="0,0,0,8"
                        Padding="14,12"
                        Style="{StaticResource Panel.Chrome}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       Text="Homecoming Installation" />
                            <TextBlock Margin="0,5,16,0"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Text="{Binding HomecomingInstallPathLabel}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,16,0"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Text="{Binding HomecomingInstallStatusLabel}"
                                       Visibility="{Binding ShowHomecomingInstallStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Margin="0,5,16,0"
                                       Foreground="{StaticResource Brush.Warning}"
                                       Text="{Binding HomecomingInstallFeedback}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasHomecomingInstallFeedback, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinWidth="92"
                                VerticalAlignment="Center"
                                Command="{Binding BrowseHomecomingInstallCommand}"
                                Content="Browse…"
                                Style="{StaticResource Button.Ghost}" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,8"
                        Padding="14,12"
                        Style="{StaticResource Panel.Chrome}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       Text="Saved Sessions" />
                            <TextBlock Margin="0,5,16,0"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Text="{Binding SavedSessionsPathLabel}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,16,0"
                                       Foreground="{StaticResource Brush.Warning}"
                                       Text="{Binding SavedSessionsFeedback}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasSavedSessionsFeedback, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinWidth="92"
                                VerticalAlignment="Center"
                                Command="{Binding OpenSavedSessionsFolderCommand}"
                                Content="Open Folder"
                                Style="{StaticResource Button.Ghost}" />
                    </Grid>
                </Border>

                <Border Padding="14,12"
                        Style="{StaticResource Panel.Chrome}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       Text="User Character Icons" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       Text="{Binding UserCharacterIconsPathLabel}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource Brush.Warning}"
                                       Text="{Binding UserCharacterIconsFeedback}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasUserCharacterIconsFeedback, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button MinWidth="92"
                                    Command="{Binding OpenUserCharacterIconsFolderCommand}"
                                    Content="Open Folder"
                                    Style="{StaticResource Button.Ghost}" />
                            <Button MinWidth="92"
                                    Margin="8,0,0,0"
                                    Command="{Binding ChangeUserCharacterIconsFolderCommand}"
                                    Content="Change…"
                                    Style="{StaticResource Button.Ghost}" />
                            <Button MinWidth="104"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetUserCharacterIconsFolderCommand}"
                                    Content="Reset Default"
                                    Style="{StaticResource Button.Ghost}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Button Grid.Row="2"
                    MinWidth="88"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    IsDefault="True"
                    Click="CloseButton_OnClick"
                    Content="Close"
                    Style="{StaticResource Button.Ghost}" />
        </Grid>
    </Grid>
</Window>
