<UserControl x:Class="CoHAnalytics.Shell.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30">
    <UserControl.Resources>
        <BitmapImage x:Key="Image.PayPalMonogram"
                     UriSource="/CoHAnalytics;component/Assets/Images/Branding/paypal-monogram.png"
                     CacheOption="OnLoad" />

        <Style x:Key="Button.StatusSupportLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ToolTip" Value="Support CoH Analytics" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Image Width="16"
                                       Height="16"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{StaticResource Image.PayPalMonogram}" />
                                <TextBlock x:Name="SupportLabel"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           Text="Support the App" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SupportLabel"
                                        Property="Foreground"
                                        Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="SupportLabel"
                                        Property="TextDecorations"
                                        Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SupportLabel"
                                        Property="Foreground"
                                        Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="SupportLabel"
                                        Property="TextDecorations"
                                        Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.StatusBar}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,1,0,0"
            Padding="18,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextMuted}">
                <Run Text="Active workspace:" />
                <Run Text="{Binding ActiveWorkspaceLabel}" Foreground="{StaticResource Brush.TextPrimary}" />
            </TextBlock>

            <Button Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource Button.StatusSupportLink}"
                    Command="{Binding OpenSupportAppCommand}"
                    AutomationProperties.Name="Support the App" />

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Margin="0,0,28,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Text="{Binding ParserStatusLabel}" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextMuted}"
                           Text="{Binding ApplicationVersion}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
