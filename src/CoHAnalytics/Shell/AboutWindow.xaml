<Window x:Class="CoHAnalytics.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:CoHAnalytics"
        xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About CoH Analytics"
        Icon="{StaticResource Image.ApplicationIcon}"
        Width="440"
        MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <windowShell:WindowChrome CaptionHeight="31"
                                  ResizeBorderThickness="0"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource Brush.ApplicationChrome}">
            <DockPanel Margin="8,0,46,0"
                       LastChildFill="True">
                <Image Width="20"
                       Height="20"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Source="{StaticResource Image.ApplicationIcon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.ApplicationChromeText}"
                           Text="About CoH Analytics" />
            </DockPanel>

            <Button Width="46"
                    Height="31"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Arrow"
                    Focusable="False"
                    ToolTip="Close"
                    windowShell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_OnClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseButtonBackground"
                                            Background="{TemplateBinding Background}">
                                        <Path Width="9"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{StaticResource Brush.ApplicationChromeText}"
                                              StrokeThickness="1" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseButtonBackground"
                                                    Property="Background"
                                                    Value="#C42B1C" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CloseButtonBackground"
                                                    Property="Background"
                                                    Value="#A62317" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          Margin="24,16,24,8"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch">
                    <Image Width="48"
                           Height="48"
                           HorizontalAlignment="Center"
                           Source="{StaticResource Image.ApplicationIcon}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               Text="{x:Static app:ApplicationMetadata.ProductName}" />

                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Text="{Binding VersionLabel}" />

                    <TextBlock Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               FontSize="12"
                               TextAlignment="Center"
                               Text="{Binding Description}" />

                    <TextBlock Margin="0,18,0,8"
                               Style="{StaticResource Text.MetricCaption}"
                               Text="PRIVACY" />

                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextAlignment="Center"
                               Text="{Binding PrivacyStatement}" />

                    <TextBlock Margin="0,18,0,8"
                               Style="{StaticResource Text.MetricCaption}"
                               Text="INDEPENDENCE" />

                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextMuted}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding IndependenceDisclaimer}" />

                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               TextAlignment="Center"
                               Text="{Binding CopyrightLine}" />

                    <Button Margin="0,16,0,0"
                            MinWidth="120"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Button.Ghost}"
                            Content="Open License"
                            Command="{Binding OpenLicenseCommand}"
                            ToolTip="Open the CoH Analytics license" />
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="1"
                    MinWidth="80"
                    Margin="24,0,24,16"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    IsDefault="True"
                    Style="{StaticResource Button.Ghost}"
                    Content="OK"
                    Click="CloseButton_OnClick" />
        </Grid>
    </Grid>
</Window>
