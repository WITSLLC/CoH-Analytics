<Window x:Class="CoHAnalytics.Shell.CustomCharacterIconEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Position Custom Character Icon"
        Icon="{StaticResource Image.ApplicationIcon}"
        Width="820"
        Height="650"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <windowShell:WindowChrome CaptionHeight="31"
                                  ResizeBorderThickness="0"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="EditorImage" TargetType="Image">
            <Setter Property="Width" Value="{Binding SourceDisplayWidth}" />
            <Setter Property="Height" Value="{Binding SourceDisplayHeight}" />
            <Setter Property="Source" Value="{Binding SourceImage}" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                        <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource Brush.ApplicationChrome}">
            <DockPanel Margin="8,0,46,0" LastChildFill="True">
                <Image Width="20" Height="20" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Source="{StaticResource Image.ApplicationIcon}"
                       Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.ApplicationChromeText}"
                           Text="Position Custom Character Icon" />
            </DockPanel>
            <Button Width="46" Height="31"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0"
                    Focusable="False" ToolTip="Close"
                    windowShell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CancelButton_OnClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBackground" Background="{TemplateBinding Background}">
                            <Path Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                  Stroke="{StaticResource Brush.ApplicationChromeText}" StrokeThickness="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="22,16,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontFamily="{StaticResource Font.Primary}"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           Text="Position Your Character" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}"
                           Text="Drag and scale the image beneath the guide. Images with a transparent background usually work best, but transparency is not required."
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="420" Height="420" HorizontalAlignment="Left"
                        Background="#08162A" BorderBrush="{StaticResource Brush.Accent}"
                        BorderThickness="1" ClipToBounds="True">
                    <Grid x:Name="EditorViewport"
                          Width="420" Height="420"
                          Background="Transparent"
                          Cursor="SizeAll"
                          MouseLeftButtonDown="EditorViewport_OnMouseLeftButtonDown"
                          MouseMove="EditorViewport_OnMouseMove"
                          MouseLeftButtonUp="EditorViewport_OnMouseLeftButtonUp"
                          LostMouseCapture="EditorViewport_OnLostMouseCapture">
                        <Image HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource EditorImage}" />
                        <Image Source="/CoHAnalytics;component/Assets/Images/CharacterIcons/gallery_silhouette.png"
                               Stretch="Fill" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Style="{StaticResource Text.MetricCaption}" Text="FINAL ICON PREVIEW" />
                    <Border Width="160" Height="160" Margin="0,8,0,20"
                            HorizontalAlignment="Left" Background="#08162A"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            ClipToBounds="True">
                        <Viewbox Width="160" Height="160" Stretch="Fill">
                            <Grid Width="420" Height="420" ClipToBounds="True">
                                <Image HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource EditorImage}" />
                            </Grid>
                        </Viewbox>
                    </Border>

                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource Text.MetricCaption}" Text="SCALE" />
                        <TextBlock Margin="8,0,0,0"
                                   Style="{StaticResource Text.MetricCaption}"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   Text="{Binding ScalePercentage}" />
                    </DockPanel>
                    <Slider Margin="0,5,0,14" Minimum="-2" Maximum="2"
                            SmallChange="0.05" LargeChange="0.5"
                            Value="{Binding ScaleSliderValue, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Text.MetricCaption}" Text="HORIZONTAL POSITION" />
                    <Slider Margin="0,5,0,14" Minimum="-420" Maximum="420"
                            SmallChange="1" LargeChange="10"
                            Value="{Binding OffsetX, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource Text.MetricCaption}" Text="VERTICAL POSITION" />
                    <Slider Margin="0,5,0,14" Minimum="-420" Maximum="420"
                            SmallChange="1" LargeChange="10"
                            Value="{Binding OffsetY, Mode=TwoWay}" />
                    <Button Width="92" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Ghost}"
                            Content="Reset / Fit"
                            Command="{Binding ResetCommand}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="88" Margin="0,0,8,0" IsCancel="True"
                        Content="Cancel" Style="{StaticResource Button.Ghost}"
                        Click="CancelButton_OnClick" />
                <Button MinWidth="88" IsDefault="True"
                        Content="Apply" Style="{StaticResource Button.Ghost}"
                        Click="ApplyButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
