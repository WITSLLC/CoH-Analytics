<Window x:Class="CoHAnalytics.Shell.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CoHAnalytics.Converters"
        xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Update Available"
        Icon="{StaticResource Image.ApplicationIcon}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <windowShell:WindowChrome CaptionHeight="31"
                                  ResizeBorderThickness="0"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource Brush.ApplicationChrome}">
            <DockPanel Margin="8,0,46,0" LastChildFill="True">
                <Image Width="20" Height="20" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Source="{StaticResource Image.ApplicationIcon}"
                       Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.ApplicationChromeText}"
                           Text="Update Available" />
            </DockPanel>
            <Button Width="46" Height="31"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    ToolTip="Close"
                    windowShell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="LaterButton_OnClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBackground" Background="{TemplateBinding Background}">
                            <Path Width="9" Height="9"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                  Stroke="{StaticResource Brush.ApplicationChromeText}"
                                  StrokeThickness="1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,22,24,18">
            <TextBlock FontFamily="{StaticResource Font.Primary}"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"
                       Text="A newer version is available" />
            <TextBlock Margin="0,14,0,0"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="13"
                       Foreground="{StaticResource Brush.TextPrimary}"
                       LineHeight="21"
                       Text="{Binding AvailableMessage}"
                       TextWrapping="Wrap" />
            <Border Margin="0,16,0,0"
                    Padding="12"
                    Background="{StaticResource Brush.PanelBackgroundLight}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasSourceBuildMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{StaticResource Text.Muted}"
                           Text="{Binding SourceBuildMessage}"
                           TextWrapping="Wrap" />
            </Border>
            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource Text.Muted}"
                       Text="CoH Analytics will not install, replace files, or restart automatically."
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,22,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="96"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Later"
                        Style="{StaticResource Button.Ghost}"
                        Click="LaterButton_OnClick" />
                <Button MinWidth="120"
                        Margin="0,0,8,0"
                        Content="{Binding ReleaseActionLabel}"
                        Style="{StaticResource Button.Ghost}"
                        Click="ViewReleaseButton_OnClick" />
                <Button MinWidth="130"
                        IsDefault="True"
                        Content="{Binding DownloadActionLabel}"
                        Style="{StaticResource Button.Ghost}"
                        Visibility="{Binding HasDownloadAction, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="DownloadButton_OnClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
