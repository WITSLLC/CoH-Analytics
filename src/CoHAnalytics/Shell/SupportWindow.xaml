<Window x:Class="CoHAnalytics.Shell.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Support CoH Analytics"
        Icon="{StaticResource Image.ApplicationIcon}"
        Width="620"
        Height="370"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <windowShell:WindowChrome CaptionHeight="31"
                                  ResizeBorderThickness="0"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="{StaticResource Brush.ApplicationChrome}">
            <DockPanel Margin="8,0,46,0"
                       LastChildFill="True">
                <Image Width="20"
                       Height="20"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Source="{StaticResource Image.ApplicationIcon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.ApplicationChromeText}"
                           Text="Support CoH Analytics" />
            </DockPanel>

            <Button Width="46"
                    Height="31"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Arrow"
                    Focusable="False"
                    ToolTip="Close"
                    windowShell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_OnClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseButtonBackground"
                                            Background="{TemplateBinding Background}">
                                        <Path Width="9"
                                              Height="9"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                              Stroke="{StaticResource Brush.ApplicationChromeText}"
                                              StrokeThickness="1" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseButtonBackground"
                                                    Property="Background"
                                                    Value="#C42B1C" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CloseButtonBackground"
                                                    Property="Background"
                                                    Value="#A62317" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontFamily="{StaticResource Font.Primary}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"
                       Text="Support CoH Analytics" />

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,4,24,0"
                            VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Text.Body}"
                               FontSize="13"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                    <Button Margin="0,22,0,0"
                            Padding="16,8"
                            HorizontalAlignment="Left"
                            TabIndex="0"
                            BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="2"
                            FontSize="13"
                            Style="{StaticResource Button.Ghost}"
                            Content="Support the App"
                            Command="{Binding OpenSupportAppCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center">
                    <Border Padding="5"
                            Background="White"
                            CornerRadius="2">
                        <Image Width="176"
                               Height="176"
                               AutomationProperties.Name="QR code for the CoH Analytics PayPal support page"
                               Focusable="False"
                               IsHitTestVisible="False"
                               Source="{Binding QrCodeSource}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Text="Scan with your phone" />
                </StackPanel>
            </Grid>

            <Button Grid.Row="2"
                    MinWidth="88"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    TabIndex="1"
                    IsCancel="True"
                    IsDefault="True"
                    Content="Close"
                    Style="{StaticResource Button.Ghost}"
                    Click="CloseButton_OnClick" />
        </Grid>
    </Grid>
</Window>
