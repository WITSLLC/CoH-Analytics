<UserControl x:Class="CoHAnalytics.Shell.ApplicationTitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DesignHeight="31"
             d:DesignWidth="1280"
             Height="31"
             Background="{StaticResource Brush.ApplicationChrome}">
    <UserControl.Resources>
        <ControlTemplate x:Key="TitleBarTopLevelItemTemplate"
                         TargetType="{x:Type MenuItem}">
            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter x:Name="HeaderPresenter"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  TextElement.Foreground="{StaticResource Brush.ApplicationChromeText}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="HeaderPresenter"
                            Property="TextElement.Foreground"
                            Value="{StaticResource Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TitleBarTopLevelHeaderTemplate"
                         TargetType="{x:Type MenuItem}">
            <Grid x:Name="TemplateRoot"
                  Background="Transparent"
                  SnapsToDevicePixels="True">
                <Border Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="HeaderPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      TextElement.Foreground="{StaticResource Brush.ApplicationChromeText}" />
                </Border>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=TemplateRoot}"
                       PopupAnimation="Fade">
                    <Border MinWidth="170"
                            Background="{StaticResource Brush.PanelBackground}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="HeaderPresenter"
                            Property="TextElement.Foreground"
                            Value="{StaticResource Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="HeaderPresenter"
                            Property="TextElement.Foreground"
                            Value="{StaticResource Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TitleBarSubmenuItemTemplate"
                         TargetType="{x:Type MenuItem}">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter x:Name="HeaderPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  TextElement.Foreground="{StaticResource Brush.TextPrimary}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.NavSelected}" />
                    <Setter TargetName="HeaderPresenter"
                            Property="TextElement.Foreground"
                            Value="{StaticResource Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TitleBarSubmenuHeaderTemplate"
                         TargetType="{x:Type MenuItem}">
            <Grid x:Name="TemplateRoot"
                  Background="Transparent"
                  SnapsToDevicePixels="True">
                <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Padding="{TemplateBinding Padding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="HeaderPresenter"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          TextElement.Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock x:Name="SubmenuArrow"
                                   Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   Text="&#x25B6;" />
                    </Grid>
                </Border>

                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       HorizontalOffset="-1"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       Placement="Right"
                       PlacementTarget="{Binding ElementName=TemplateRoot}"
                       PopupAnimation="Fade">
                    <Border MinWidth="170"
                            Background="{StaticResource Brush.PanelBackground}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.NavSelected}" />
                    <Setter TargetName="HeaderPresenter"
                            Property="TextElement.Foreground"
                            Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.NavSelected}" />
                    <Setter TargetName="HeaderPresenter"
                            Property="TextElement.Foreground"
                            Value="{StaticResource Brush.Accent}" />
                    <Setter TargetName="SubmenuArrow" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
               TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1"
                                Background="{StaticResource Brush.Border}"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Foreground" Value="{StaticResource Brush.ApplicationChromeText}" />
                    <Setter Property="Height" Value="31" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Template" Value="{StaticResource TitleBarTopLevelHeaderTemplate}" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Foreground" Value="{StaticResource Brush.ApplicationChromeText}" />
                    <Setter Property="Height" Value="31" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Template" Value="{StaticResource TitleBarTopLevelItemTemplate}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource TitleBarSubmenuHeaderTemplate}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource TitleBarSubmenuItemTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Left"
                Orientation="Horizontal">
        <Image Width="20"
               Height="20"
               Margin="8,0,6,0"
               VerticalAlignment="Center"
               Source="{StaticResource Image.ApplicationIcon}"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <Menu x:Name="ApplicationMenu"
              Height="31"
              Margin="0"
              Padding="0"
              VerticalAlignment="Center"
              Background="Transparent"
              Foreground="{StaticResource Brush.ApplicationChromeText}"
              windowShell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Settings"
                      Command="{Binding OpenSettingsCommand}" />
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _Updates"
                          Command="{Binding CheckForUpdatesCommand}" />
                <Separator />
                <MenuItem Header="_Create Diagnostics Report…"
                          Command="{Binding CreateDiagnosticsReportCommand}" />
                <MenuItem Header="_Report a Bug"
                          Command="{Binding OpenReportBugCommand}" />
                <MenuItem Header="_Project Home (GitHub)"
                          Command="{Binding OpenProjectHomeCommand}" />
                <MenuItem Header="_Homecoming"
                          Command="{Binding OpenHomecomingCommand}" />
                <MenuItem Header="Support the App…"
                          Command="{Binding ShowSupportCommand}" />
                <Separator />
                <MenuItem Header="_About CoH Analytics"
                          Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>
    </StackPanel>
</UserControl>
