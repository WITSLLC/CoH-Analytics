<Window x:Class="CoHAnalytics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:CoHAnalytics.Shell"
        xmlns:windowShell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="CoH Analytics"
        Icon="/CoHAnalytics;component/Assets/Images/Application/coh-analytics-app-icon.ico"
        Width="1280"
        Height="950"
        MinWidth="1280"
        MinHeight="950"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <windowShell:WindowChrome CaptionHeight="31"
                                  ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                                  GlassFrameThickness="{x:Static SystemParameters.WindowNonClientFrameThickness}"
                                  UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="31" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <shell:ApplicationTitleBarView x:Name="ApplicationTitleBar"
                                       Grid.Row="0"
                                       Margin="0,0,138,0" />
        <TextBlock Grid.Row="0"
                   Panel.ZIndex="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource Font.Primary}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.ApplicationChromeText}"
                   IsHitTestVisible="False"
                   Text="CoH Analytics" />
        <Button x:Name="MinimizeButton"
                Grid.Row="0"
                Width="46"
                Height="31"
                Margin="0,0,92,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Minimize"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Arrow"
                Focusable="False"
                ToolTip="Minimize"
                windowShell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="MinimizeButton_OnClick">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBackground"
                                        Background="{TemplateBinding Background}">
                                    <Path Width="10"
                                          Height="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0,0.5 L 10,0.5"
                                          Stroke="{StaticResource Brush.ApplicationChromeText}"
                                          StrokeThickness="1" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground"
                                                Property="Background"
                                                Value="#8A3442" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ButtonBackground"
                                                Property="Background"
                                                Value="#51202A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <Border x:Name="NativeCaptionBottomFill"
                Grid.Row="0"
                Width="138"
                Height="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{StaticResource Brush.ApplicationChrome}"
                IsHitTestVisible="False" />
        <shell:ShellView Grid.Row="1"
                         Background="{StaticResource Brush.WindowBackground}" />
    </Grid>
</Window>
