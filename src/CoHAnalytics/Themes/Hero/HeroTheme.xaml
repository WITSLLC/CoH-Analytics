<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Hero theme color tokens -->
    <Color x:Key="Color.DeepNavy">#010614</Color>
    <Color x:Key="Color.DeepNavyMid">#041A3C</Color>
    <Color x:Key="Color.CobaltPanel">#0A1E3D</Color>
    <Color x:Key="Color.CobaltPanelLight">#10284A</Color>
    <Color x:Key="Color.HeroCyan">#00EAFF</Color>
    <Color x:Key="Color.HeroBlue">#1A3A6E</Color>
    <Color x:Key="Color.TextPrimary">#E0F7FA</Color>
    <!-- Application text uses one high-contrast white; hierarchy comes from size and weight, not muting. -->
    <Color x:Key="Color.TextMuted">#E0F7FA</Color>
    <Color x:Key="Color.Success">#6EE07A</Color>
    <Color x:Key="Color.Warning">#FFCC44</Color>
    <Color x:Key="Color.Attention">#FF9933</Color>
    <Color x:Key="Color.Error">#FF5566</Color>
    <Color x:Key="Color.Border">#1E4A7A</Color>
    <Color x:Key="Color.BorderGlow">#3300EAFF</Color>
    <Color x:Key="Color.ApplicationChrome">#6B2430</Color>
    <Color x:Key="Color.ApplicationChromeText">#FFF7F8</Color>

    <!-- Inspiration semantic effect-family colors (presentation only; tier-neutral). -->
    <Color x:Key="Color.InspirationDamage">#FF5555</Color>
    <Color x:Key="Color.InspirationAccuracy">#FFFF66</Color>
    <Color x:Key="Color.InspirationDefense">#66B2FF</Color>
    <Color x:Key="Color.InspirationResistance">#C080FF</Color>
    <Color x:Key="Color.InspirationHealth">#6EE07A</Color>
    <Color x:Key="Color.InspirationEndurance">#00EAFF</Color>
    <Color x:Key="Color.InspirationResurrection">#FF99CC</Color>
    <Color x:Key="Color.InspirationStatusProtection">#FF9933</Color>
    <Color x:Key="Color.InspirationLevelShift">#FFD700</Color>
    <Color x:Key="Color.InspirationSpecial">#C8D4E0</Color>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.DeepNavy}" />
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="{StaticResource Color.CobaltPanel}" />
    <SolidColorBrush x:Key="Brush.PanelBackgroundLight" Color="{StaticResource Color.CobaltPanelLight}" />
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="{StaticResource Color.DeepNavyMid}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.HeroCyan}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.ReferenceRarityUncommon" Color="#FFFF00" />
    <SolidColorBrush x:Key="Brush.ReferenceRarityRare" Color="#FF8040" />
    <SolidColorBrush x:Key="Brush.ReferenceRarityVeryRare" Color="#A082DC" />
    <SolidColorBrush x:Key="Brush.InspirationDamage" Color="{StaticResource Color.InspirationDamage}" />
    <SolidColorBrush x:Key="Brush.InspirationAccuracy" Color="{StaticResource Color.InspirationAccuracy}" />
    <SolidColorBrush x:Key="Brush.InspirationDefense" Color="{StaticResource Color.InspirationDefense}" />
    <SolidColorBrush x:Key="Brush.InspirationResistance" Color="{StaticResource Color.InspirationResistance}" />
    <SolidColorBrush x:Key="Brush.InspirationHealth" Color="{StaticResource Color.InspirationHealth}" />
    <SolidColorBrush x:Key="Brush.InspirationEndurance" Color="{StaticResource Color.InspirationEndurance}" />
    <SolidColorBrush x:Key="Brush.InspirationResurrection" Color="{StaticResource Color.InspirationResurrection}" />
    <SolidColorBrush x:Key="Brush.InspirationStatusProtection" Color="{StaticResource Color.InspirationStatusProtection}" />
    <SolidColorBrush x:Key="Brush.InspirationLevelShift" Color="{StaticResource Color.InspirationLevelShift}" />
    <SolidColorBrush x:Key="Brush.InspirationSpecial" Color="{StaticResource Color.InspirationSpecial}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Attention" Color="{StaticResource Color.Attention}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#1A4578" />
    <SolidColorBrush x:Key="Brush.StatusBar" Color="#020A18" />
    <SolidColorBrush x:Key="Brush.ApplicationChrome" Color="{StaticResource Color.ApplicationChrome}" />
    <SolidColorBrush x:Key="Brush.ApplicationChromeText" Color="{StaticResource Color.ApplicationChromeText}" />
    <BitmapImage x:Key="Image.ApplicationIcon"
                 UriSource="/CoHAnalytics;component/Assets/Images/Application/coh-analytics-app-icon.png" />

    <!-- Selectable chip/tab tokens (Accounts character Overview/Badges authority). -->
    <Color x:Key="Color.ChipInactiveBackground">#0D2240</Color>
    <Color x:Key="Color.ChipActiveBackground">#143A5C</Color>
    <Color x:Key="Color.ChipDisabledBackground">#081628</Color>
    <Color x:Key="Color.ChipDisabledBorder">#1A3558</Color>
    <SolidColorBrush x:Key="Brush.ChipInactiveBackground" Color="{StaticResource Color.ChipInactiveBackground}" />
    <SolidColorBrush x:Key="Brush.ChipActiveBackground" Color="{StaticResource Color.ChipActiveBackground}" />
    <SolidColorBrush x:Key="Brush.ChipDisabledBackground" Color="{StaticResource Color.ChipDisabledBackground}" />
    <SolidColorBrush x:Key="Brush.ChipDisabledBorder" Color="{StaticResource Color.ChipDisabledBorder}" />
    <SolidColorBrush x:Key="Brush.ChipActiveForeground" Color="{StaticResource Color.Warning}" />
    <CornerRadius x:Key="SelectableChip.CornerRadius.Standard">16</CornerRadius>
    <CornerRadius x:Key="SelectableChip.CornerRadius.Tab">14</CornerRadius>
    <CornerRadius x:Key="SelectableChip.CornerRadius.SessionTab">4</CornerRadius>
    <Thickness x:Key="SelectableChip.Padding.Standard">12,6</Thickness>
    <Thickness x:Key="SelectableChip.Padding.Compact">10,5</Thickness>

    <DropShadowEffect x:Key="Effect.PanelGlow"
                      Color="#00EAFF"
                      BlurRadius="14"
                      ShadowDepth="0"
                      Opacity="0.32" />

    <DropShadowEffect x:Key="Effect.PanelGlow.Subtle"
                      Color="#00EAFF"
                      BlurRadius="8"
                      ShadowDepth="0"
                      Opacity="0.22" />

    <LinearGradientBrush x:Key="Brush.WorkspaceBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.DeepNavy}" Offset="0" />
        <GradientStop Color="{StaticResource Color.DeepNavyMid}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PanelSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0C2342" Offset="0" />
        <GradientStop Color="{StaticResource Color.CobaltPanel}" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>

    <!-- Version 1 global icon sizing standard (logical pixels) -->
    <sys:Double x:Key="Icon.Size.Navigation">60</sys:Double>
    <sys:Double x:Key="Icon.Size.PanelHeader">60</sys:Double>
    <sys:Double x:Key="Icon.Size.Environment">60</sys:Double>
    <sys:Double x:Key="Icon.Size.Status">48</sys:Double>
    <sys:Double x:Key="Icon.Size.MonitoringDecorative">168</sys:Double>
    <sys:Double x:Key="Icon.Size.MonitoringDecorative.Compact">84</sys:Double>
    <sys:Double x:Key="Icon.Size.InlineGlyph">20</sys:Double>
    <sys:Double x:Key="Icon.Size.Monitoring.Account">45</sys:Double>
    <sys:Double x:Key="Icon.Size.InlineAction">14</sys:Double>
    <sys:Double x:Key="Icon.Size.WorkspaceIndicator">22</sys:Double>
    <sys:Double x:Key="Icon.Size.EnvironmentStatus">24</sys:Double>
    <!-- Environment strip optical render-size overrides (logical pixels).
         These four production assets have different transparent margins and visual
         densities. The sizes below target equal perceived size, not identical
         pixel dimensions. Pair with Icon.Environment.Component in the strip layout. -->
    <sys:Double x:Key="Icon.Size.Environment.Optical.HomecomingInstall">65</sys:Double>
    <sys:Double x:Key="Icon.Size.Environment.Optical.MidsRebornInstall">65</sys:Double>
    <sys:Double x:Key="Icon.Size.Environment.Optical.EnhancementDatabase">56</sys:Double>
    <sys:Double x:Key="Icon.Size.Environment.Optical.BuildLibrary">56</sys:Double>
    <GridLength x:Key="Icon.Layout.NavigationColumn">72</GridLength>
    <Thickness x:Key="Icon.Layout.NavigationLabelMargin">10,0,8,0</Thickness>

    <Style x:Key="Icon.Navigation" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Navigation}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Navigation}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="Icon.PanelHeader" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource Icon.Size.PanelHeader}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.PanelHeader}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="Icon.Accounts.Artwork" TargetType="Image">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="MaxHeight" Value="120" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="Icon.Environment.Component" TargetType="Image">
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="Icon.Environment" TargetType="Image" BasedOn="{StaticResource Icon.Environment.Component}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Environment}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Environment}" />
    </Style>

    <Style x:Key="Icon.EnvironmentStatus" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource Icon.Size.EnvironmentStatus}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.EnvironmentStatus}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="Icon.Status" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Status}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Status}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Shared content typography used across workspace cards and detail panels. -->
    <Style x:Key="Text.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Text.MetricCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.DetailTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.EmphasizedValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.CompactBody" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="Text.ContextStrip" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.ContextLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.ContextStrip}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="Text.ContextValue" TargetType="TextBlock" BasedOn="{StaticResource Text.ContextStrip}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.StatusHeadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
    </Style>

    <Style x:Key="Text.StatusRowLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
    </Style>

    <Style x:Key="Text.StatusRowValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
    </Style>

    <Style x:Key="Text.WelcomePlaceholder" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.MessageIdentityTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.MessageIdentityTagline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <Style x:Key="Text.AttentionHeadline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Attention}" />
    </Style>

    <Style x:Key="Panel.Chrome" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PanelSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect" Value="{StaticResource Effect.PanelGlow}" />
    </Style>

    <Style x:Key="Panel.DashboardHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PanelSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Effect" Value="{StaticResource Effect.PanelGlow}" />
    </Style>

    <!-- Standard workspace title panel (Accounts, placeholders; not Dashboard). -->
    <Style x:Key="Panel.WorkspaceTitle" TargetType="Border" BasedOn="{StaticResource Panel.Chrome}">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1,0,1,0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Hero skyline — fills middle title-band cell; uniform scale, no crop. -->
    <Style x:Key="Image.WorkspaceTitleSkyline" TargetType="Image">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="Source" Value="pack://application:,,,/Assets/Images/Header/extended_header.png" />
    </Style>

    <Style x:Key="Panel.WorkspaceTitleSkyline" TargetType="Grid">
        <Setter Property="Margin" Value="8,0,-7,0" />
    </Style>

    <Style x:Key="Image.WorkspaceTitleLogo" TargetType="Image">
        <Setter Property="Panel.ZIndex" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxHeight" Value="108" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="Source" Value="pack://application:,,,/Assets/Images/Header/logo-hero.png" />
    </Style>

    <Style x:Key="Panel.Welcome" TargetType="Border" BasedOn="{StaticResource Panel.Chrome}" />

    <Style x:Key="Panel.Monitoring.Compact" TargetType="Border" BasedOn="{StaticResource Panel.Chrome}">
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="Panel.TileInner" TargetType="Border">
        <Setter Property="Background" Value="#0D2240" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Effect" Value="{StaticResource Effect.PanelGlow.Subtle}" />
    </Style>

    <Style x:Key="Panel.Monitoring.TileCompact" TargetType="Border" BasedOn="{StaticResource Panel.TileInner}">
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="Panel.AccountCard" TargetType="Border" BasedOn="{StaticResource Panel.TileInner}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#6EE07A" BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Panel.EnvironmentColumn" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="14,6,14,6" />
    </Style>

    <Style x:Key="Text.EnvironmentTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.EnvironmentStatus" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game Status layered icon: base housing is untinted; crystal tint and bloom are driven by GameStatusState. -->
    <sys:Double x:Key="GameStatus.Crystal.OffOpacity">0.06</sys:Double>

    <SolidColorBrush x:Key="Brush.ComboBoxBackground" Color="#0D2240" />
    <SolidColorBrush x:Key="Brush.ComboBoxItemHover" Color="#1A4578" />
    <SolidColorBrush x:Key="Brush.ComboBoxItemSelected" Color="#1A3558" />

    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="ToggleBorder"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0">
            <Path x:Name="Arrow"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{StaticResource Brush.Accent}"
                  Stretch="Uniform"
                  Width="8"
                  Height="5" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Arrow" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource Brush.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="Width" Value="10" />
        <Style.Resources>
            <Style TargetType="Thumb">
                <Setter Property="Background" Value="#1E4A7A" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.ComboBoxItemHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.ComboBoxItemSelected}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.ComboBoxItemHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Background" Value="{StaticResource Brush.ComboBoxBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ChromeBorder"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Cursor="Hand"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Template="{StaticResource ComboBoxToggleButtonTemplate}" />
                        <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsHitTestVisible="False"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{StaticResource Brush.PanelBackground}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,2,0,0"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="2"
                                              CanContentScroll="True"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChromeBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ChromeBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="ChromeBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="Brush.TreeViewItemHover" Color="#1A4578" />
    <SolidColorBrush x:Key="Brush.TreeViewItemSelected" Color="#1A3558" />
    <SolidColorBrush x:Key="Brush.TreeViewItemSelectedInactive" Color="#142945" />

    <!-- Navigation rows in browse/detail lists: suppress stock WPF focus/press chrome and
         reuse the same restrained TreeView selection language. -->
    <Style x:Key="Button.NavigationRow" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.TreeViewItemHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.TreeViewItemSelected}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="RowBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TreeViewExpanderToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"
                            Width="16"
                            Height="16">
                        <Path x:Name="ExpandPath"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 0 L 0 8 L 6 4 Z"
                              Fill="{StaticResource Brush.Accent}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ExpandPath" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ExpandPath" Property="Fill" Value="{StaticResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ExpandPath" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="19" Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander"
                                      Grid.Column="1"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Style="{StaticResource TreeViewExpanderToggle}" />
                        <Border x:Name="ItemBorder"
                                Grid.Column="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Header"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.TreeViewItemHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.TreeViewItemSelected}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.TreeViewItemSelectedInactive}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.TreeViewItemHover}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent host for selectable chips whose visual chrome lives on a child Border. -->
    <Style x:Key="Button.SelectableChipHost" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accounts character Overview/Badges tab button — visual authority for active chip treatment. -->
    <Style x:Key="Button.SelectableChip" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.ChipInactiveBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="{StaticResource SelectableChip.Padding.Standard}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SelectableChip.CornerRadius.Tab}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            UseLayoutRounding="{TemplateBinding UseLayoutRounding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextOptions.TextFormattingMode="Display"
                                          TextOptions.TextRenderingMode="ClearType" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource Brush.ChipActiveBackground}" />
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.ChipActiveForeground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource Brush.ChipDisabledBackground}" />
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.ChipDisabledBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.SelectableChip.Active" TargetType="Button" BasedOn="{StaticResource Button.SelectableChip}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.ChipActiveBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.ChipActiveForeground}" />
    </Style>

    <Style x:Key="Button.SelectableChip.SessionTab" TargetType="Button" BasedOn="{StaticResource Button.SelectableChip}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource SelectableChip.CornerRadius.SessionTab}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            UseLayoutRounding="{TemplateBinding UseLayoutRounding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextOptions.TextFormattingMode="Display"
                                          TextOptions.TextRenderingMode="ClearType" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource Brush.ChipActiveBackground}" />
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.ChipActiveForeground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource Brush.ChipDisabledBackground}" />
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.ChipDisabledBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Border.SelectableChip" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource SelectableChip.Padding.Standard}" />
        <Setter Property="CornerRadius" Value="{StaticResource SelectableChip.CornerRadius.Standard}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.ChipInactiveBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.ChipActiveBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Border.SelectableChip.Compact" TargetType="Border" BasedOn="{StaticResource Border.SelectableChip}">
        <Setter Property="Padding" Value="{StaticResource SelectableChip.Padding.Compact}" />
        <Setter Property="CornerRadius" Value="{StaticResource SelectableChip.CornerRadius.Tab}" />
    </Style>

    <Style x:Key="Text.SelectableChipLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.ChipActiveForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Text.SelectableChipLabel.Compact" TargetType="TextBlock" BasedOn="{StaticResource Text.SelectableChipLabel}">
        <Setter Property="FontSize" Value="11" />
    </Style>

</ResourceDictionary>
