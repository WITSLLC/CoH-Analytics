<UserControl x:Class="CoHAnalytics.Controls.GameStatusIconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72"
             Height="72"
             Margin="0,0,14,0"
             Cursor="Hand">
    <UserControl.Resources>
        <Storyboard x:Key="GameStatus.Pulse.Idle" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CrystalIllumination"
                             Storyboard.TargetProperty="Opacity"
                             From="0.48"
                             To="0.72"
                             Duration="0:0:2"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="GameStatus.Pulse.Running" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CrystalIllumination"
                             Storyboard.TargetProperty="Opacity"
                             From="0.68"
                             To="0.92"
                             Duration="0:0:1.5"
                             AutoReverse="True" />
        </Storyboard>

        <Storyboard x:Key="GameStatus.Pulse.Error" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CrystalIllumination"
                             Storyboard.TargetProperty="Opacity"
                             From="0.58"
                             To="0.86"
                             Duration="0:0:2.5"
                             AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Image Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="pack://application:,,,/Assets/Images/Status/GameStatus_Base.png" />
        <Rectangle x:Name="CrystalIllumination"
                   RenderOptions.BitmapScalingMode="HighQuality">
            <Rectangle.Fill>
                <SolidColorBrush x:Name="CrystalFill" Color="{StaticResource Color.Success}" />
            </Rectangle.Fill>
            <Rectangle.OpacityMask>
                <ImageBrush ImageSource="pack://application:,,,/Assets/Images/Status/GameStatus_Mask.png"
                            Stretch="Uniform" />
            </Rectangle.OpacityMask>
            <Rectangle.Effect>
                <DropShadowEffect x:Name="CrystalBloom"
                                  ShadowDepth="0"
                                  BlurRadius="0"
                                  Opacity="0" />
            </Rectangle.Effect>
        </Rectangle>
    </Grid>
</UserControl>
