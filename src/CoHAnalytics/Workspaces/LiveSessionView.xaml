<UserControl x:Class="CoHAnalytics.Workspaces.LiveSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CoHAnalytics.Converters"
             xmlns:controls="clr-namespace:CoHAnalytics.Controls"
             xmlns:vmw="clr-namespace:CoHAnalytics.ViewModels.Workspaces"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             MaxHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter" />
        <conv:ReferenceRarityBrushConverter x:Key="ReferenceRarityBrushConverter" />
        <conv:BrushResourceKeyConverter x:Key="BrushResourceKeyConverter" />

        <SolidColorBrush x:Key="Brush.CurrencyBronze" Color="#C9953C" />
        <SolidColorBrush x:Key="Brush.CurrencyAstral" Color="#5FA8FF" />
        <SolidColorBrush x:Key="Brush.CurrencyPrismatic" Color="#B58CFF" />

        <Style x:Key="Panel.LiveCard" TargetType="Border" BasedOn="{StaticResource Panel.Chrome}">
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="Panel.LiveCardDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource Brush.Border}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style x:Key="Panel.LiveRowDivider" TargetType="Border" BasedOn="{StaticResource Panel.LiveCardDivider}">
            <Setter Property="Margin" Value="0,7,0,7" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style x:Key="Text.LiveCardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}" />

        <Style x:Key="Text.LiveSectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        </Style>

        <Style x:Key="Toggle.LootSectionHeader" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBackground" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Text.LiveSessionTabPrimary" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.ChipActiveForeground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Text.LiveSessionTabSecondary" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Text.LiveViewedContextStripLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.ContextLabel}" />

        <Style x:Key="Text.LiveViewedContextStripValue" TargetType="TextBlock" BasedOn="{StaticResource Text.ContextValue}" />

        <Style x:Key="Text.LiveCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.MetricCaption}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Text.LiveDuration" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="Text.LiveRate" TargetType="TextBlock" BasedOn="{StaticResource Text.MetricValue}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="Text.LiveTotal" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Text.LiveRowName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Match the 12px bold session-status value while retaining display-optimized rendering. -->
        <Style x:Key="Text.LootItemName"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="Text.LiveRowValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="Text.LiveEmptyState" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- Currency names receive restrained game-inspired colour; quantities retain application white. -->
        <DataTemplate x:Key="Template.LiveCurrencyRow">
            <StackPanel>
                <Border Style="{StaticResource Panel.LiveRowDivider}"
                        Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Grid Margin="0,3,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.LiveRowName}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NameColor}"
                                                 Value="{x:Static vmw:LiveSessionCurrencyNameColor.Bronze}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.CurrencyBronze}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NameColor}"
                                                 Value="{x:Static vmw:LiveSessionCurrencyNameColor.Gold}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NameColor}"
                                                 Value="{x:Static vmw:LiveSessionCurrencyNameColor.Blue}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.CurrencyAstral}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NameColor}"
                                                 Value="{x:Static vmw:LiveSessionCurrencyNameColor.Orange}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Attention}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NameColor}"
                                                 Value="{x:Static vmw:LiveSessionCurrencyNameColor.White}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NameColor}"
                                                 Value="{x:Static vmw:LiveSessionCurrencyNameColor.Amber}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Attention}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NameColor}"
                                                 Value="{x:Static vmw:LiveSessionCurrencyNameColor.Purple}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.CurrencyPrismatic}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Text="{Binding QuantityLabel}"
                               Style="{StaticResource Text.LiveRowValue}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Aggregate row shared by non-currency reward summaries. -->
        <DataTemplate x:Key="Template.LiveAggregateRow">
            <StackPanel>
                <Border Style="{StaticResource Panel.LiveRowDivider}"
                        Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Grid Margin="0,3,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}"
                               Style="{StaticResource Text.LiveRowName}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding QuantityLabel}"
                               Style="{StaticResource Text.LiveRowValue}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Item row. Names render exactly as Homecoming emitted them. -->
        <DataTemplate x:Key="Template.LiveItemRow">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}"
                           Style="{StaticResource Text.LiveRowName}"
                           ToolTip="{Binding DisplayName}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding QuantityLabel}"
                           Style="{StaticResource Text.LiveRowValue}" />
            </Grid>
        </DataTemplate>

        <!-- Catalog-backed loot row: canonical rarity colour and optional Homecoming artwork. -->
        <DataTemplate x:Key="Template.LiveCatalogLootItemRow">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                       Width="{StaticResource Icon.Size.InlineGlyph}"
                       Height="{StaticResource Icon.Size.InlineGlyph}"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       Source="{Binding IconSource}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayName}"
                           ToolTip="{Binding DisplayName}"
                           Style="{StaticResource Text.LootItemName}"
                           Foreground="{Binding PresentationBrushKey, Converter={StaticResource BrushResourceKeyConverter}}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding QuantityLabel}"
                           Style="{StaticResource Text.LiveRowValue}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Template.LiveLootItemRow">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}"
                           Style="{StaticResource Text.LootItemName}"
                           ToolTip="{Binding DisplayName}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding QuantityLabel}"
                           Style="{StaticResource Text.LiveRowValue}" />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.WorkspaceBackground}" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Panel.WorkspaceTitle}"
                Margin="0,0,0,8">
            <Grid Height="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}"
                               Margin="0,6,0,0"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <controls:WorkspaceStatusPanelView Grid.Column="2"
                                                     DataContext="{Binding}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Panel.Chrome}"
                Padding="10,8"
                Margin="0,0,0,8"
                Visibility="{Binding ShowSessionTabs, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding SessionTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vmw:LiveSessionTabViewModel}">
                        <Button Command="{Binding DataContext.SelectSessionTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.SelectableChip.SessionTab}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                            <Setter Property="Background" Value="{StaticResource Brush.ChipActiveBackground}" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.ChipActiveForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding PrimaryLabel}"
                                           Style="{StaticResource Text.LiveSessionTabPrimary}"
                                           MaxWidth="160" />
                                <TextBlock Text="{Binding SecondaryLabel}"
                                           Style="{StaticResource Text.LiveSessionTabSecondary}"
                                           MaxWidth="160"
                                           Visibility="{Binding SecondaryLabel, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Viewed session identity strip -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Border Style="{StaticResource Panel.Chrome}"
                    Padding="14,10"
                    Visibility="{Binding ShowNoContextNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Active Character"
                               Style="{StaticResource Text.LiveSectionTitle}" />
                    <TextBlock Text="No monitoring contexts are active."
                               Margin="0,4,0,0"
                               Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding ShowViewedContextStrip, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource Panel.Chrome}" Padding="14,10">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Select Character"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Button.Ghost}"
                                Visibility="{Binding ViewedRequiresManualSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding OpenCharacterPickerCommand}" />

                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Account:"
                                       Margin="0,0,6,0"
                                       Style="{StaticResource Text.LiveViewedContextStripLabel}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ViewedAccountLabel}"
                                       Style="{StaticResource Text.LiveViewedContextStripValue}" />

                            <TextBlock Grid.Column="3"
                                       Text="Character:"
                                       Margin="0,0,6,0"
                                       Style="{StaticResource Text.LiveViewedContextStripLabel}" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding ViewedCharacterLabel}"
                                       Style="{StaticResource Text.LiveViewedContextStripValue}" />

                            <TextBlock Grid.Column="6"
                                       Text="Status:"
                                       Margin="0,0,6,0"
                                       Style="{StaticResource Text.LiveViewedContextStripLabel}" />
                            <TextBlock Grid.Column="7"
                                       Text="{Binding ViewedStatusLabel}"
                                       Style="{StaticResource Text.LiveViewedContextStripValue}"
                                       Foreground="{Binding ViewedIdentityStatusKind, Converter={StaticResource StatusKindToBrushConverter}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <ContentControl Content="{Binding ViewedContextPanel}" Margin="0,8,0,0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vmw:LiveSessionContextPanelViewModel}">
                            <Border Style="{StaticResource Panel.TileInner}"
                                    Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Select Character"
                                               Style="{StaticResource Text.SectionTitle}" />
                                    <TextBlock Text="Choose an existing character on this account."
                                               Margin="0,4,0,8"
                                               Style="{StaticResource Text.Muted}" />
                                    <ListBox ItemsSource="{Binding PickerCharacters}"
                                             SelectedItem="{Binding SelectedPickerCharacter, Mode=TwoWay}"
                                             MaxHeight="180"
                                             MinHeight="120"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                                    <TextBlock Text="{Binding LastObservedLabel}"
                                                               Margin="0,2,0,0"
                                                               Style="{StaticResource Text.Muted}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding SelectionMessage}"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource Brush.Error}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasSelectionMessage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Confirm Selection"
                                                Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.ConfirmSelectedCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button Content="Cancel"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.CloseCharacterPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </Grid>

        <!-- Six-card session summary. Always visible; only the data changes. -->
        <Grid Grid.Row="3" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Card 1 — Total Session -->
            <Border Grid.Row="0" Grid.Column="0"
                    Margin="0,0,6,6"
                    ClipToBounds="True"
                    Style="{StaticResource Panel.LiveCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="TOTAL SESSION"
                               Style="{StaticResource Text.LiveCardTitle}" />
                    <Border Grid.Row="1" Style="{StaticResource Panel.LiveCardDivider}" />

                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Status" Style="{StaticResource Text.LiveCaption}" />
                            <TextBlock Text="{Binding SessionStateLabel}"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                        </StackPanel>

                        <TextBlock Text="Duration" Style="{StaticResource Text.LiveCaption}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SessionDurationLabel}"
                                   Style="{StaticResource Text.LiveDuration}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Influence / Hour" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding SessionGameplayInfluenceRateLabel}"
                                           Style="{StaticResource Text.LiveRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Influence" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding SessionGameplayInfluenceLabel}"
                                           Style="{StaticResource Text.LiveTotal}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="XP / Hour" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding SessionExperienceRateLabel}"
                                           Style="{StaticResource Text.LiveRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total XP" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding SessionExperienceLabel}"
                                           Style="{StaticResource Text.LiveTotal}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SessionPrimaryPerformanceRateCaption}"
                                           Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding SessionPrimaryPerformanceRateLabel}"
                                           Style="{StaticResource Text.LiveRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SessionPrimaryPerformanceTotalCaption}"
                                           Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding SessionPrimaryPerformanceTotalLabel}"
                                           Style="{StaticResource Text.LiveTotal}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Save"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding SaveLiveSessionCommand}" />
                        <Button Grid.Column="2"
                                Content="Clear"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ClearSessionCommand}" />
                        <Button Grid.Column="4"
                                Content="Clear + Rewards"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ClearSessionAndRewardsCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2 — Tracked Session -->
            <Border Grid.Row="0" Grid.Column="1"
                    Margin="6,0,6,6"
                    ClipToBounds="True"
                    Style="{StaticResource Panel.LiveCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="TRACKED SESSION"
                               Style="{StaticResource Text.LiveCardTitle}" />
                    <Border Grid.Row="1" Style="{StaticResource Panel.LiveCardDivider}" />

                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Status" Style="{StaticResource Text.LiveCaption}" />
                            <TextBlock Text="{Binding TrackedSessionStatusLabel}"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                        </StackPanel>

                        <TextBlock Text="Duration" Style="{StaticResource Text.LiveCaption}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding TrackedSessionDurationLabel}"
                                   Style="{StaticResource Text.LiveDuration}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Influence / Hour" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding TrackedSessionGameplayInfluenceRateLabel}"
                                           Style="{StaticResource Text.LiveRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Influence" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding TrackedSessionGameplayInfluenceLabel}"
                                           Style="{StaticResource Text.LiveTotal}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="XP / Hour" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding TrackedSessionExperienceRateLabel}"
                                           Style="{StaticResource Text.LiveRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total XP" Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding TrackedSessionExperienceLabel}"
                                           Style="{StaticResource Text.LiveTotal}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding TrackedSessionPrimaryPerformanceRateCaption}"
                                           Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding TrackedSessionPrimaryPerformanceRateLabel}"
                                           Style="{StaticResource Text.LiveRate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding TrackedSessionPrimaryPerformanceTotalCaption}"
                                           Style="{StaticResource Text.LiveCaption}" />
                                <TextBlock Text="{Binding TrackedSessionPrimaryPerformanceTotalLabel}"
                                           Style="{StaticResource Text.LiveTotal}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <UniformGrid Grid.Row="3" Rows="1" Columns="4" Margin="0,12,0,0">
                        <Button Content="Start"
                                Margin="0,0,4,0"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding StartTrackedSessionCommand}" />
                        <Button Content="{Binding TrackedSessionPauseResumeLabel}"
                                Margin="4,0,4,0"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ToggleTrackedSessionPauseCommand}" />
                        <Button Content="Save"
                                Margin="4,0,4,0"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding SaveTrackedSessionCommand}" />
                        <Button Content="Reset"
                                Margin="4,0,0,0"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding ResetTrackedSessionCommand}" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Card 3 — Currencies -->
            <Border Grid.Row="0" Grid.Column="2"
                    Margin="6,0,0,6"
                    ClipToBounds="True"
                    Style="{StaticResource Panel.LiveCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="CURRENCIES"
                               Style="{StaticResource Text.LiveCardTitle}" />
                    <Border Grid.Row="1" Style="{StaticResource Panel.LiveCardDivider}" />

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,8,0,0"
                                  MinHeight="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Currencies}"
                                      ItemTemplate="{StaticResource Template.LiveCurrencyRow}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Card 4 — Recipes -->
            <Border Grid.Row="1" Grid.Column="0"
                    Margin="0,6,6,0"
                    ClipToBounds="True"
                    Style="{StaticResource Panel.LiveCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="RECIPES"
                               Style="{StaticResource Text.LiveCardTitle}" />
                    <Border Grid.Row="1" Style="{StaticResource Panel.LiveCardDivider}" />

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recipe" Style="{StaticResource Text.LiveSectionTitle}" />
                        <TextBlock Grid.Column="1"
                                   Text="Qty"
                                   Margin="8,0,0,0"
                                   Style="{StaticResource Text.LiveSectionTitle}" />
                    </Grid>

                    <Grid Grid.Row="3" MinHeight="0">
                        <TextBlock Text="No recipes collected."
                                   Style="{StaticResource Text.LiveEmptyState}"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding HasRecipes, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ScrollViewer MinHeight="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,8,0"
                                      Margin="0,4,0,0"
                                      Visibility="{Binding HasRecipes, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Recipes}"
                                          ItemTemplate="{StaticResource Template.LiveCatalogLootItemRow}" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 5 — Loot / Drops -->
            <Border Grid.Row="1" Grid.Column="1"
                    Margin="6,6,6,0"
                    ClipToBounds="True"
                    Style="{StaticResource Panel.LiveCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="LOOT / DROPS"
                               Style="{StaticResource Text.LiveCardTitle}" />
                    <Border Grid.Row="1" Style="{StaticResource Panel.LiveCardDivider}" />

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,8,0,0"
                                  MinHeight="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,8,0">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsSalvageExpanded, Mode=TwoWay}"
                                          Style="{StaticResource Toggle.LootSectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.LiveSectionTitle}">
                                                <Setter Property="Text" Value="▶" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="▼" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SalvageSectionHeader}"
                                               Style="{StaticResource Text.LiveSectionTitle}" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel Visibility="{Binding IsSalvageExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding SalvageDrops}"
                                              Margin="18,4,0,0"
                                              ItemTemplate="{StaticResource Template.LiveCatalogLootItemRow}"
                                              Visibility="{Binding HasSalvageDrops, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="No salvage collected."
                                           Margin="18,0,0,0"
                                           Style="{StaticResource Text.LootItemName}"
                                           Visibility="{Binding HasSalvageDrops, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>

                            <ToggleButton IsChecked="{Binding IsEnhancementsExpanded, Mode=TwoWay}"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource Toggle.LootSectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.LiveSectionTitle}">
                                                <Setter Property="Text" Value="▶" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="▼" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EnhancementSectionHeader}"
                                               Style="{StaticResource Text.LiveSectionTitle}" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel Visibility="{Binding IsEnhancementsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding EnhancementDrops}"
                                              Margin="18,4,0,0"
                                              ItemTemplate="{StaticResource Template.LiveCatalogLootItemRow}"
                                              Visibility="{Binding HasEnhancementDrops, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="No enhancements collected."
                                           Margin="18,0,0,0"
                                           Style="{StaticResource Text.LootItemName}"
                                           Visibility="{Binding HasEnhancementDrops, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>

                            <ToggleButton IsChecked="{Binding IsInspirationsExpanded, Mode=TwoWay}"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource Toggle.LootSectionHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.LiveSectionTitle}">
                                                <Setter Property="Text" Value="▶" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                 Value="True">
                                                        <Setter Property="Text" Value="▼" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InspirationSectionHeader}"
                                               Style="{StaticResource Text.LiveSectionTitle}" />
                                </Grid>
                            </ToggleButton>
                            <StackPanel Visibility="{Binding IsInspirationsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding InspirationDrops}"
                                              Margin="18,4,0,0"
                                              ItemTemplate="{StaticResource Template.LiveCatalogLootItemRow}"
                                              Visibility="{Binding HasInspirationDrops, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="No inspirations collected."
                                           Margin="18,0,0,0"
                                           Style="{StaticResource Text.LootItemName}"
                                           Visibility="{Binding HasInspirationDrops, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Card 6 — Special Rewards -->
            <Border Grid.Row="1" Grid.Column="2"
                    Margin="6,6,0,0"
                    ClipToBounds="True"
                    Style="{StaticResource Panel.LiveCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="SPECIAL REWARDS"
                               Style="{StaticResource Text.LiveCardTitle}" />
                    <Border Grid.Row="1" Style="{StaticResource Panel.LiveCardDivider}" />

                    <ScrollViewer Grid.Row="2"
                                  Margin="0,8,0,0"
                                  MinHeight="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SpecialRewards}"
                                          ItemTemplate="{StaticResource Template.LiveAggregateRow}" />
                            <TextBlock Text="No special rewards collected."
                                       Style="{StaticResource Text.LiveEmptyState}"
                                       Visibility="{Binding HasSpecialRewards, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
