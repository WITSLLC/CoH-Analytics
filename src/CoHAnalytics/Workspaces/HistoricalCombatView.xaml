<UserControl x:Class="CoHAnalytics.Workspaces.HistoricalCombatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CoHAnalytics.Converters">
    <StackPanel>
        <Border Style="{StaticResource Panel.Chrome}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource Button.Ghost}" Padding="8,3" />
                        <TextBlock Text="HISTORICAL SEGMENT" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Account" Style="{StaticResource Text.ContextLabel}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CombatAccountSelector" ItemsSource="{Binding AccountsChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedAccount}" MinWidth="100" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Character" Style="{StaticResource Text.ContextLabel}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CombatCharacterSelector" ItemsSource="{Binding CharacterChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedCharacter}" MinWidth="100" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Segment" Style="{StaticResource Text.ContextLabel}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CombatSegmentSelector" ItemsSource="{Binding SegmentChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedSegment}" MinWidth="150" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CharacterName}" Style="{StaticResource Text.SectionTitle}" Margin="0,12,0,4" />
                    <WrapPanel>
                        <TextBlock Text="{Binding CharacterDetails}" Style="{StaticResource Text.ContextValue}" VerticalAlignment="Center"
                                   Margin="0,0,14,0" Visibility="{Binding CharacterDetails, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                        <Button x:Name="CombatReportButton" Content="↗ Report" Command="{Binding ReportCommand}"
                                Style="{StaticResource Button.Ghost}" Padding="10,4" />
                    </WrapPanel>
                </StackPanel>
                <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource Brush.Border}" Padding="18,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Run Name" Style="{StaticResource Text.ContextLabel}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveRunNameCommand}"
                                    Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Padding="8,4" />
                            <TextBox x:Name="CombatRunNameEditor" Text="{Binding RunName, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditRunName}" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding RunNameHint}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding RunNameHint, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Capture start" Style="{StaticResource Text.ContextLabel}" Margin="0,0,12,4"
                                       Visibility="{Binding CaptureStart, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                            <TextBlock Grid.Column="1" Text="{Binding CaptureStart}" Style="{StaticResource Text.ContextValue}" />
                            <TextBlock Grid.Row="1" Text="Capture end" Style="{StaticResource Text.ContextLabel}" Margin="0,0,12,4"
                                       Visibility="{Binding CaptureEnd, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CaptureEnd}" Style="{StaticResource Text.ContextValue}" />
                            <TextBlock Grid.Row="2" Text="Session length" Style="{StaticResource Text.ContextLabel}" Margin="0,0,12,4"
                                       Visibility="{Binding SessionLength, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SessionLength}" Style="{StaticResource Text.ContextValue}" />
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding BuildLabel}" Style="{StaticResource Text.ContextValue}"
                                       Visibility="{Binding BuildLabel, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={x:Static conv:NullToVisibilityConverter.Instance}}" />
        <ItemsControl ItemsSource="{Binding Sections}" Margin="0,8,0,8">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Button.SelectableChipHost}"
                            Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}">
                        <Border Style="{StaticResource Border.SelectableChip}">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.SelectableChipLabel}" />
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource Panel.Chrome}" Padding="18">
            <StackPanel>
                <TextBlock Text="{Binding SelectedSection}" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Text="Select a segment and open Report to view its captured combat analytics."
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
