<UserControl x:Class="CoHAnalytics.Workspaces.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CoHAnalytics.Converters"
             xmlns:controls="clr-namespace:CoHAnalytics.Controls"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{StaticResource Brush.WorkspaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Panel.WorkspaceTitle}"
                Margin="0,0,0,8">
            <Grid Height="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding Description}"
                               Margin="0,6,0,0"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <controls:WorkspaceStatusPanelView Grid.Column="2"
                                                     DataContext="{Binding}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource Panel.Chrome}"
                Padding="14,12"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="GAME INSTALLATION"
                           Style="{StaticResource Text.SectionTitle}"
                           Margin="0,0,0,12" />

                <TextBlock Text="Homecoming Installation"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}" />
                <TextBlock Text="Location of your Homecoming game files."
                           Margin="0,4,0,12"
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding HomecomingInstallPathLabel}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Content="Browse…"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding BrowseHomecomingInstallCommand}" />
                </Grid>

                <TextBlock Text="{Binding HomecomingInstallStatusLabel}"
                           Margin="0,8,0,0"
                           Style="{StaticResource Text.Muted}"
                           Visibility="{Binding ShowHomecomingInstallStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="{Binding HomecomingInstallFeedback}"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource Brush.Warning}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasHomecomingInstallFeedback, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
